PORT=5000
MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>/<database>
JWT_SECRET=<cadena-aleatoria-larga-y-unica>
FRONTEND_URL=https://sistema-integral-de-indicadores-zxuf.onrender.com,http://localhost:8081,http://127.0.0.1:8081
# --- Alertas push (erika/alertas) ---
# Genera las llaves con: npm run vapid
VAPID_PUBLIC_KEY=<llave-publica-vapid>
VAPID_PRIVATE_KEY=<llave-privada-vapid>
# Contacto del administrador del servicio push (mailto: o https:)
VAPID_SUBJECT=mailto:<correo-institucional>
# Opcionales (valores por defecto entre paréntesis)
# SEMAFORO_UMBRAL_ROJO=70
# SEMAFORO_UMBRAL_VERDE=90
# SEMAFORO_UMBRAL_SOBRE=120
# ALERTA_DIAS_PRORROGA=15
# ALERTA_HORAS_POSPONER=24
# ALERTA_DIAS_AVISO_CIERRE=7,2
# ALERTAS_CRON_DIARIO=0 8 * * *
# ALERTAS_CRON=off   (desactiva las tareas programadas)
