PORT=5000
MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>/<database>
JWT_SECRET=<cadena-aleatoria-larga-y-unica>
FRONTEND_URL=https://sistema-integral-de-indicadores-zxuf.onrender.com,http://localhost,http://127.0.0.1,http://localhost:8081,http://127.0.0.1:8081

# --- Preauditorías con IA (Groq) ---
GROQ_API_KEY=<clave-de-groq>
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_MAX_DOCUMENT_CHARS=24000
# Máximo de preauditorías por usuario en 24 horas (por defecto 20)
# PREAUDITORIA_MAX_DIARIAS=20

# --- Asistente general SIDII (Gemini API gratuita) ---
# Crear una clave en https://aistudio.google.com/apikey y configurarla solo en el backend.
GEMINI_API_KEY=<clave-de-gemini>
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Seguridad ---
# Intentos de inicio de sesión o registro por IP cada 15 minutos (por defecto 10)
# LOGIN_MAX_INTENTOS=10

# --- Alertas push (erika/alertas) ---
# Genera las llaves con: npm run vapid
VAPID_PUBLIC_KEY=<llave-publica-vapid>
VAPID_PRIVATE_KEY=<llave-privada-vapid>
# Contacto del administrador del servicio push (mailto: o https:)
VAPID_SUBJECT=mailto:<correo-institucional>
# Opcionales (valores por defecto entre paréntesis)
# ALERTA_DIAS_PRORROGA=15
# ALERTA_HORAS_POSPONER=24
# ALERTA_DIAS_AVISO_CIERRE=7,2
# ALERTAS_CRON_DIARIO=0 8 * * *
# ALERTAS_CRON=off   (desactiva las tareas programadas)
